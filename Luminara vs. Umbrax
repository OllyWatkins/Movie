                    </div>
                    
                    <!-- Track 3 -->
                    <div class="flex items-center p-4 bg-gray-800 rounded-lg hover:bg-gray-700 transition cursor-pointer">
                        <div class="w-12 h-12 rounded bg-gray-600 flex items-center justify-center mr-4">
                            <i class="fas fa-music"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-medium">Umbrax's Wrath</h4>
                            <p class="text-sm text-gray-400">Villain Theme</p>
                        </div>
                        <div class="text-gray-400">2:58</div>
                    </div>
                    
                    <!-- Track 4 -->
                    <div class="flex items-center p-4 bg-gray-800 rounded-lg hover:bg-gray-700 transition cursor-pointer">
                        <div class="w-12 h-12 rounded bg-blue-600 flex items-center justify-center mr-4">
                            <i class="fas fa-music"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-medium">Training Montage</h4>
                            <p class="text-sm text-gray-400">Upbeat Sequence</p>
                        </div>
                        <div class="text-gray-400">1:45</div>
                    </div>
                    
                    <!-- Track 5 -->
                    <div class="flex items-center p-4 bg-gray-800 rounded-lg hover:bg-gray-700 transition cursor-pointer">
                        <div class="w-12 h-12 rounded bg-red-600 flex items-center justify-center mr-4">
                            <i class="fas fa-music"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-medium">Final Battle</h4>
                            <p class="text-sm text-gray-400">Climactic Theme</p>
                        </div>
                        <div class="text-gray-400">4:22</div>
                    </div>
                    
                    <!-- Track 6 -->
                    <div class="flex items-center p-4 bg-gray-800 rounded-lg hover:bg-gray-700 transition cursor-pointer">
                        <div class="w-12 h-12 rounded bg-green-600 flex items-center justify-center mr-4">
                            <i class="fas fa-music"></i>
                        </div>
                        <div class="flex-1">
                            <h4 class="font-medium">Balance Restored</h4>
                            <p class="text-sm text-gray-400">Ending Theme</p>
                        </div>
                        <div class="text-gray-400">3:45</div>
                    </div>
                </div>
                
                <div class="mt-8 bg-gradient-to-r from-purple-900 to-pink-900 rounded-xl p-6">
                    <h3 class="text-xl font-bold mb-4">Sound Design</h3>
                    <p class="text-gray-300 mb-4">
                        The soundtrack features an epic orchestral score for battles, emotional piano and strings for introspective moments, 
                        and realistic sound effects for action scenes (explosions, power surges).
                    </p>
                    <button class="px-6 py-3 bg-purple-600 hover:bg-purple-500 rounded-lg font-medium transition">
                        <i class="fas fa-headphones mr-2"></i> Listen to Full Soundtrack
                    </button>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 border-t border-purple-900 py-8 px-4 md:px-12">
        <div class="container mx-auto">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-6 md:mb-0">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-full bg-yellow-500 flex items-center justify-center power-light">
                            <i class="fas fa-bolt text-white"></i>
                        </div>
                        <h2 class="text-xl font-bold">Luminara vs. Umbrax</h2>
                    </div>
                    <p class="text-gray-400 mt-2 text-sm">A 10-minute animated superhero movie</p>
                </div>
                
                <div class="flex space-x-6">
                    <a href="#" class="text-gray-400 hover:text-white transition">
                        <i class="fab fa-youtube text-xl"></i>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-white transition">
                        <i class="fab fa-twitter text-xl"></i>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-white transition">
                        <i class="fab fa-instagram text-xl"></i>
                    </a>
                    <a href="#" class="text-gray-400 hover:text-white transition">
                        <i class="fab fa-imdb text-xl"></i>
                    </a>
                </div>
            </div>
            
            <div class="mt-8 pt-6 border-t border-gray-800 text-center text-gray-500 text-sm">
                <p>© 2023 Animated Superhero Productions. All assets uniquely generated to avoid copyright issues.</p>
                <p class="mt-2">Animation style: Realistic 3D with vibrant colors for light and dark muted tones for shadows.</p>
            </div>
        </div>
    </footer>

    <script>
        // Tab functionality
        document.querySelectorAll('.tab-button').forEach(button => {
            button.addEventListener('click', function() {
                // Remove active class from all buttons
                document.querySelectorAll('.tab-button').forEach(btn => {
                    btn.classList.remove('tab-active');
                    btn.classList.add('text-gray-400');
                });
                
                // Add active class to clicked button
                this.classList.add('tab-active');
                this.classList.remove('text-gray-400');
                
                // Hide all tab contents
                document.querySelectorAll('.tab-content').forEach(content => {
                    content.classList.add('hidden');
                });
                
                // Show selected tab content
                const tabId = this.getAttribute('data-tab') + '-tab';
                document.getElementById(tabId).classList.remove('hidden');
            });
        });
        
        // Simulate progress bar animation
        const progressBar = document.querySelector('.progress-bar');
        let progress = 0;
        
        setInterval(() => {
            if (progress < 100) {
                progress += 0.5;
                progressBar.style.width = `${progress}%`;
                
                // Update current time
                const totalSeconds = 600; // 10 minutes
                const currentSeconds = Math.floor(totalSeconds * (progress / 100));
                const minutes = Math.floor(currentSeconds / 60);
                const seconds = currentSeconds % 60;
                document.querySelector('.time-current').textContent = 
                    `${minutes}:${seconds.toString().padStart(2, '0')}`;
            }
        }, 300);
        
        // Simulate play button click
        document.querySelector('.movie-screen').addEventListener('click', function(e) {
            if (e.target.closest('.fa-play')) {
                alert('Movie playback would start here in the full version. This is just a UI demo.');
            }
        });
        
        // Scene buttons
        document.querySelectorAll('.scene-card button').forEach(button => {
            button.addEventListener('click', function(e) {
                e.stopPropagation();
                alert('Scene preview would play here in the full version. This is just a UI demo.');
            });
        });
    </script>
</body>
</html>
