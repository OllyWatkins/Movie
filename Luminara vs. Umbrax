<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Luminara vs. Umbrax - Superhero Movie</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Roboto:wght@300;400;700&display=swap');
        
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #0a0a1a;
            color: white;
            overflow-x: hidden;
        }
        
        .movie-screen {
            background: linear-gradient(135deg, #000000 0%, #1a1a2e 100%);
            box-shadow: 0 0 30px rgba(106, 90, 205, 0.3);
        }
        
        .progress-bar {
            height: 6px;
            background: linear-gradient(90deg, #4f46e5 0%, #9333ea 50%, #ec4899 100%);
        }
        
        .character-card {
            transition: all 0.3s ease;
            background: linear-gradient(145deg, #1e1b4b 0%, #312e81 100%);
        }
        
        .character-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
        }
        
        .villain-card {
            background: linear-gradient(145deg, #3f3f46 0%, #18181b 100%);
        }
        
        .villain-card:hover {
            box-shadow: 0 10px 25px rgba(244, 63, 94, 0.3);
        }
        
        .scene-card {
            transition: all 0.3s ease;
            background-size: cover;
            background-position: center;
        }
        
        .scene-card:hover {
            transform: scale(1.03);
        }
        
        .scene-overlay {
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.3) 50%, rgba(0,0,0,0) 100%);
        }
        
        .power-light {
            box-shadow: 0 0 20px 5px rgba(234, 179, 8, 0.6);
        }
        
        .power-dark {
            box-shadow: 0 0 20px 5px rgba(75, 85, 99, 0.6);
        }
        
        .glow-text {
            text-shadow: 0 0 10px rgba(234, 179, 8, 0.8);
        }
        
        .dark-text {
            text-shadow: 0 0 10px rgba(75, 85, 99, 0.8);
        }
        
        @keyframes pulse-glow {
            0% { opacity: 0.8; }
            50% { opacity: 1; }
            100% { opacity: 0.8; }
        }
        
        .pulse {
            animation: pulse-glow 2s infinite;
        }
        
        .tab-active {
            border-bottom: 3px solid #818cf8;
            color: white;
        }
    </style>
</head>
<body class="min-h-screen">
    <!-- Header -->
    <header class="bg-gray-900 py-6 px-4 md:px-12 border-b border-purple-900">
        <div class="container mx-auto flex flex-col md:flex-row justify-between items-center">
            <div class="flex items-center space-x-4 mb-4 md:mb-0">
                <div class="w-12 h-12 rounded-full bg-yellow-500 flex items-center justify-center power-light">
                    <i class="fas fa-bolt text-white text-xl"></i>
                </div>
                <h1 class="text-3xl font-bold bg-gradient-to-r from-yellow-400 via-purple-500 to-pink-500 bg-clip-text text-transparent">
                    Luminara vs. Umbrax
                </h1>
            </div>
            <div class="flex space-x-4">
                <button class="px-4 py-2 bg-purple-600 hover:bg-purple-500 rounded-lg flex items-center space-x-2 transition">
                    <i class="fas fa-play"></i>
                    <span>Watch Trailer</span>
                </button>
                <button class="px-4 py-2 bg-gray-800 hover:bg-gray-700 rounded-lg flex items-center space-x-2 transition">
                    <i class="fas fa-info-circle"></i>
                    <span>About</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <!-- Movie Player Section -->
        <section class="mb-16">
            <div class="movie-screen rounded-xl overflow-hidden relative">
                <!-- Placeholder for movie player -->
                <div class="w-full h-64 md:h-96 bg-black flex items-center justify-center relative">
                    <div class="absolute inset-0 flex items-center justify-center">
                        <div class="text-center">
                            <div class="w-20 h-20 rounded-full bg-yellow-500 flex items-center justify-center mx-auto mb-4 power-light pulse">
                                <i class="fas fa-play text-white text-2xl"></i>
                            </div>
                            <h3 class="text-xl font-semibold">Play "Luminara vs. Umbrax"</h3>
                            <p class="text-gray-400">10 min animated superhero movie</p>
                        </div>
                    </div>
                </div>
                
                <!-- Progress bar -->
                <div class="progress-bar w-0"></div>
                
                <!-- Controls -->
                <div class="bg-gray-900 p-4 flex items-center justify-between">
                    <div class="flex items-center space-x-4">
                        <button class="w-10 h-10 rounded-full bg-gray-800 hover:bg-gray-700 flex items-center justify-center transition">
                            <i class="fas fa-play"></i>
                        </button>
                        <div class="text-sm">
                            <span class="time-current">0:00</span> / <span class="time-total">10:00</span>
                        </div>
                    </div>
                    <div class="flex items-center space-x-4">
                        <button class="w-8 h-8 text-gray-400 hover:text-white transition">
                            <i class="fas fa-volume-up"></i>
                        </button>
                        <button class="w-8 h-8 text-gray-400 hover:text-white transition">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tabs Navigation -->
        <div class="flex border-b border-gray-800 mb-8">
            <button class="tab-button px-6 py-3 font-medium text-gray-400 hover:text-white transition tab-active" data-tab="characters">
                Characters
            </button>
            <button class="tab-button px-6 py-3 font-medium text-gray-400 hover:text-white transition" data-tab="scenes">
                Key Scenes
            </button>
            <button class="tab-button px-6 py-3 font-medium text-gray-400 hover:text-white transition" data-tab="powers">
                Superpowers
            </button>
            <button class="tab-button px-6 py-3 font-medium text-gray-400 hover:text-white transition" data-tab="soundtrack">
                Soundtrack
            </button>
        </div>

        <!-- Characters Tab -->
        <section id="characters-tab" class="tab-content">
            <h2 class="text-2xl font-bold mb-6 glow-text">Meet the Characters</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Luminara -->
                <div class="character-card rounded-xl overflow-hidden">
                    <div class="h-48 bg-gradient-to-br from-yellow-500 to-yellow-300 flex items-end justify-center relative">
                        <img src="https://placeholder.co/300x400" alt="Luminara" class="absolute -bottom-10 w-32 h-32 rounded-full border-4 border-yellow-500 object-cover">
                    </div>
                    <div class="p-6 pt-16 text-center">
                        <h3 class="text-xl font-bold mb-2">Luminara</h3>
                        <p class="text-yellow-400 mb-4">The Lightbringer</p>
                        <p class="text-gray-300 text-sm">
                            A reluctant hero who discovers her light manipulation powers after a personal tragedy. 
                            Struggles with self-doubt but grows into her role as the city's protector.
                        </p>
                        <div class="mt-4 flex justify-center space-x-2">
                            <span class="px-3 py-1 bg-yellow-500 bg-opacity-20 text-yellow-400 rounded-full text-xs">Light Powers</span>
                            <span class="px-3 py-1 bg-purple-500 bg-opacity-20 text-purple-400 rounded-full text-xs">Resilient</span>
                        </div>
                    </div>
                </div>
                
                <!-- Umbrax -->
                <div class="character-card villain-card rounded-xl overflow-hidden">
                    <div class="h-48 bg-gradient-to-br from-gray-800 to-gray-900 flex items-end justify-center relative">
                        <img src="https://placeholder.co/300x400" alt="Umbrax" class="absolute -bottom-10 w-32 h-32 rounded-full border-4 border-gray-700 object-cover">
                    </div>
                    <div class="p-6 pt-16 text-center">
                        <h3 class="text-xl font-bold mb-2">Umbrax</h3>
                        <p class="text-gray-400 mb-4">The Shadow King</p>
                        <p class="text-gray-300 text-sm">
                            A mysterious villain who controls shadows to manipulate and attack. 
                            Driven by revenge against the city for past grievances.
                        </p>
                        <div class="mt-4 flex justify-center space-x-2">
                            <span class="px-3 py-1 bg-gray-500 bg-opacity-20 text-gray-400 rounded-full text-xs">Shadow Powers</span>
                            <span class="px-3 py-1 bg-red-500 bg-opacity-20 text-red-400 rounded-full text-xs">Vengeful</span>
                        </div>
                    </div>
                </div>
                
                <!-- Jax -->
                <div class="character-card rounded-xl overflow-hidden">
                    <div class="h-48 bg-gradient-to-br from-blue-500 to-blue-300 flex items-end justify-center relative">
                        <img src="https://placeholder.co/300x400" alt="Jax" class="absolute -bottom-10 w-32 h-32 rounded-full border-4 border-blue-500 object-cover">
